(package
  (name "zscheme-stdlib")
  (version "0.2.0")
  (import-prefix "stdlib")
  (sources
    (main "src")
    (test "test"))
  (dependencies
    (nuget
      [System.Collections.Immutable "9.0.0"]))
  (test-dependencies
    (zscheme
      [zunit :local "../zunit"]))
  (build
    (main
      (namespace "ZScheme.StdLib"))
    (test
      (namespace "ZScheme.StdLib.Tests"))))
