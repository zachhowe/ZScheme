(package
  (name "zscheme-stdlib")
  (version "0.1.1")
  (import-prefix "stdlib")
  (sources
    (main "src")
    (test "test"))
  (dependencies
    (nuget
      [System.Collections.Immutable "9.0.0"]))
  (test-dependencies
    (zscheme
      [zunit :local "../zunit"]))
  (build
    (namespace "ZScheme.StdLib")))
