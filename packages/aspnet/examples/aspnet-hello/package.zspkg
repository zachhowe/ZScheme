(package
  (name "aspnet-hello")
  (version "0.1.0")
  (entry "src/main.zs")
  (sources
    (main "src"))
  (dependencies
    (zscheme
      [aspnet :local "../.."]
      [di-abstractions :local "../../../di-abstractions"]
      [logging-abstractions :local "../../../logging-abstractions"])
    (framework Microsoft.AspNetCore.App))
  (build
    (main
      (namespace "AspNetHello")
      (backend "il")
      (output-type "Exe"))))
