(package
  (name "aspnet-hello")
  (version "0.1.0")
  (entry "src/main.zs")
  (sources
    (main "src"))
  (dependencies
    (zscheme
      [stdlib :local "../../../stdlib"]
      [aspnet :local "../.."])
    (framework Microsoft.AspNetCore.App))
  (build
    (main
      (namespace "AspNetHello")
      (backend "il")
      (output-type "Exe"))))
