(package
  (name "zscheme-aspnet")
  (version "0.4.0")
  (import-prefix "aspnet")
  (description "Minimalist ASP.NET Core wrapper: routing, middleware, request/response")
  (license "MIT")
  (sources
    (main "src")
    (test "test"))
  (dependencies
    (zscheme
      [stdlib :local "../stdlib"]
      [di-abstractions :local "../di-abstractions"]
      [logging-abstractions :local "../logging-abstractions"]
      [logging :local "../logging"])
    (framework Microsoft.AspNetCore.App))
  (test-dependencies
    (zscheme
      [zunit :local "../zunit"]
      [http :local "../http"]))
  (build
    (main
      (namespace "ZScheme.AspNet"))
    (test
      (namespace "ZScheme.AspNet.Tests"))))
