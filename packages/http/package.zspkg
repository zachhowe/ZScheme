(package
  (name "zscheme-http")
  (version "0.4.0")
  (import-prefix "http")
  (default-module "http")
  (sources
    (main "src")
    (test "test"))
  (dependencies
    (zscheme
      [stdlib :local "../stdlib"]))
  (test-dependencies
    (zscheme
      [zunit :local "../zunit"]))
  (build
    (main
      (namespace "ZScheme.Http"))
    (test
      (namespace "ZScheme.Http.Tests"))))
