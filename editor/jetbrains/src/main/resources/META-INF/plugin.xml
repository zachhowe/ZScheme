<idea-plugin>
  <id>com.zachhowe.zscheme</id>
  <name>ZScheme</name>
  <vendor>Zach Howe</vendor>
  <description>
    <![CDATA[
        Language support for ZScheme, a Scheme-like functional programming language that compiles to .NET.
        <ul>
            <li>Syntax highlighting for .zs and .zspkg files</li>
            <li>Brace matching for parentheses and brackets</li>
            <li>Line commenting with semicolons</li>
            <li>Auto-closing string quotes</li>
        </ul>
    ]]>
  </description>

  <depends>com.intellij.modules.platform</depends>

  <extensions defaultExtensionNs="com.intellij">
    <fileType
      name="ZScheme"
      implementationClass="com.zachhowe.zscheme.ZSchemeFileType"
      fieldName="INSTANCE"
      language="ZScheme"
      extensions="zs;zspkg"
    />

    <lang.parserDefinition
      language="ZScheme"
      implementationClass="com.zachhowe.zscheme.ZSchemeParserDefinition"
    />

    <lang.syntaxHighlighterFactory
      language="ZScheme"
      implementationClass="com.zachhowe.zscheme.ZSchemeSyntaxHighlighterFactory"
    />

    <colorSettingsPage implementation="com.zachhowe.zscheme.ZSchemeColorSettingsPage" />

    <lang.braceMatcher
      language="ZScheme"
      implementationClass="com.zachhowe.zscheme.ZSchemeBraceMatcher"
    />

    <lang.commenter
      language="ZScheme"
      implementationClass="com.zachhowe.zscheme.ZSchemeCommenter"
    />

    <lang.quoteHandler
      language="ZScheme"
      implementationClass="com.zachhowe.zscheme.ZSchemeQuoteHandler"
    />
  </extensions>
</idea-plugin>
