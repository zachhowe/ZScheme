        },
        {
          "type": "SYMBOL",
          "name": "colon"
        }
      ]
    },
    "comment": {
      "type": "PATTERN",
      "value": ";.*"
    },
    "list": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "("
            },
            {
              "type": "STRING",
              "value": ")"
            }
          ]
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "("
            },
            {
              "type": "FIELD",
              "name": "head",
              "content": {
                "type": "SYMBOL",
                "name": "_form"
              }
            },
            {
              "type": "REPEAT",
              "content": {
                "type": "SYMBOL",
                "name": "_form"
              }
            },
            {
              "type": "STRING",
              "value": ")"
            }
          ]
        }
      ]
    },
    "bracket_list": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "["
