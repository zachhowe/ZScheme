            "type": "STRING",
            "value": ":"
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "STRING",
                "value": "instance-property"
              },
              {
                "type": "STRING",
                "value": "instance-indexer"
              },
              {
                "type": "STRING",
                "value": "instance"
              },
              {
                "type": "STRING",
                "value": "where"
              }
            ]
          }
        ]
      }
    },
    "type_variable": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "^"
          },
          {
            "type": "PATTERN",
            "value": "[a-z]"
          },
          {
            "type": "REPEAT",
            "content": {
              "type": "PATTERN",
              "value": "[a-zA-Z_+\\-*/=<>!?&|%^~#@0-9.\\->]"
            }
          }
        ]
      }
    },
    "symbol": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "PATTERN",
            "value": "[a-zA-Z_+\\-*/=<>!?&|%^~#@]"
          },
          {
            "type": "REPEAT",
            "content": {
              "type": "PATTERN",
              "value": "[a-zA-Z_+\\-*/=<>!?&|%^~#@0-9.\\->]"
            }
          }
        ]
