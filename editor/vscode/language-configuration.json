{
  "comments": {
    "lineComment": ";"
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"],
    ["\"", "\""]
  ],
  "wordPattern": "[a-zA-Z_+\\-*/=<>!?&|%^~#@][a-zA-Z_+\\-*/=<>!?&|%^~#@0-9.\\->]*",
  "indentationRules": {
    "increaseIndentPattern": "\\(",
    "decreaseIndentPattern": "^\\s*\\)"
  }
}
