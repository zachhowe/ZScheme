{
  "name": "zscheme",
  "displayName": "ZScheme",
  "description": "ZScheme language support with syntax highlighting and Language Server Protocol integration",
  "version": "0.5.0",
  "publisher": "zscheme",
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:zscheme"
  ],
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p ."
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/vscode": "^1.82.0",
    "typescript": "^5.0.0"
  },
  "contributes": {
    "languages": [
      {
        "id": "zscheme",
        "aliases": [
          "ZScheme",
          "zscheme"
        ],
        "extensions": [
          ".zs",
          ".zspkg"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "zscheme",
        "scopeName": "source.zscheme",
        "path": "./syntaxes/zscheme.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "ZScheme",
      "properties": {
        "zscheme.languageServer.path": {
          "type": "string",
          "default": "",
          "description": "Path to the ZScheme language server executable (zs-lsp). Leave empty to disable LSP features."
        },
        "zscheme.languageServer.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional arguments to pass to the language server."
        }
      }
    }
  }
}