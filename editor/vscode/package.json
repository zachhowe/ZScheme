{
  "name": "zscript",
  "displayName": "ZScript",
  "description": "ZScript language support with syntax highlighting and Language Server Protocol integration",
  "version": "0.2.0",
  "publisher": "zscript",
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:zscript"
  ],
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p ."
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/vscode": "^1.82.0",
    "typescript": "^5.0.0"
  },
  "contributes": {
    "languages": [
      {
        "id": "zscript",
        "aliases": [
          "ZScript",
          "zscript"
        ],
        "extensions": [
          ".zs",
          ".zspkg"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "zscript",
        "scopeName": "source.zscript",
        "path": "./syntaxes/zscript.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "ZScript",
      "properties": {
        "zscript.languageServer.path": {
          "type": "string",
          "default": "",
          "description": "Path to the ZScript language server executable. Leave empty to disable LSP features."
        },
        "zscript.languageServer.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional arguments to pass to the language server."
        }
      }
    }
  }
}
