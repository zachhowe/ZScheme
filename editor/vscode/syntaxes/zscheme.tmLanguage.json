{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "ZScheme",
  "scopeName": "source.zscheme",
  "fileTypes": ["zs"],
  "patterns": [
    { "include": "#expressions" }
  ],
  "repository": {
    "expressions": {
      "patterns": [
        { "include": "#line-comment" },
        { "include": "#string" },
        { "include": "#float" },
        { "include": "#integer" },
        { "include": "#boolean" },
        { "include": "#s-expression" },
        { "include": "#brackets" },
        { "include": "#flag-keywords" },
        { "include": "#clr-qualifiers" },
        { "include": "#colon" },
        { "include": "#wildcard" },
        { "include": "#ellipsis" },
        { "include": "#super-call" },
        { "include": "#value-constructors" },
        { "include": "#type-names" },
        { "include": "#type-variables" },
        { "include": "#constraint-keywords" },
        { "include": "#identifiers" }
      ]
    },

    "line-comment": {
      "match": ";.*$",
      "name": "comment.line.semicolon.zscheme"
    },

    "string": {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double.zscheme",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.zscheme" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.zscheme" }
      },
      "patterns": [
        {
          "match": "\\\\[ntr\\\\\"']",
          "name": "constant.character.escape.zscheme"
        }
      ]
    },

    "float": {
      "patterns": [
        {
          "match": "-?[0-9]+\\.[0-9]+[fF]?(?![a-zA-Z_+\\-*/=<>!?&|%^~#@0-9.\\->])",
          "name": "constant.numeric.float.zscheme"
        },
        {
          "match": "-?[0-9]+[fF](?![a-zA-Z_+\\-*/=<>!?&|%^~#@0-9.\\->])",
          "name": "constant.numeric.float.zscheme"
        },
        {
          "match": "\\.[0-9]+(?![a-zA-Z_+\\-*/=<>!?&|%^~#@0-9.\\->])",
          "name": "constant.numeric.float.zscheme"
        }
      ]
    },

    "integer": {
      "match": "-?[0-9]+(?![.[0-9fF]])(?![a-zA-Z_+\\-*/=<>!?&|%^~#@0-9.\\->])",
      "name": "constant.numeric.integer.zscheme"
    },

    "boolean": {
      "patterns": [
        {
          "match": "(?:#t|#f)(?![a-zA-Z_+\\-*/=<>!?&|%^~#@0-9.\\->])",
          "name": "constant.language.boolean.zscheme"
        },
        {
          "match": "\\bnull\\b",
          "name": "constant.language.null.zscheme"
        }
      ]
    },

    "s-expression": {
      "begin": "\\(",
      "end": "\\)",
      "beginCaptures": {
        "0": { "name": "punctuation.section.parens.begin.zscheme" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.section.parens.end.zscheme" }
      },
      "patterns": [
        { "include": "#head-keyword-control" },
        { "include": "#head-keyword-module" },
        { "include": "#head-attribute" },
        { "include": "#head-keyword-other" },
        { "include": "#head-operator-pipe" },
        { "include": "#head-operator" },
        { "include": "#head-type-name" },
        { "include": "#super-call" },
        { "include": "#head-function-call" },
        { "include": "#expressions" }
      ]
    },

    "head-keyword-control": {
      "comment": "The AstBuilder special-form switch, plus the macro layer's define-syntax/syntax-rules and the type-expression keyword 'delegate'. Longest alternatives first so a prefix cannot shadow a longer form.",
      "match": "(?<=\\()(?:define-syntax|define-async|define-type-alias|define-record|define-struct|define-union|define-class|define-interface|define|letrec|let\\*|let|use\\*|use|if|lambda|match|with-handlers|with|set!|begin|new|raise|await|syntax-rules|typeof|delegate|values|quote)(?![a-zA-Z_+\\-*/=<>!?&|%^~#@0-9.\\->])",
      "name": "keyword.control.zscheme"
    },

    "head-keyword-module": {
      "match": "(?<=\\()(?:namespace|module|import|export|import-clr)(?![a-zA-Z_+\\-*/=<>!?&|%^~#@0-9.\\->])",
      "name": "keyword.control.module.zscheme"
    },

    "head-attribute": {
      "match": "(?<=\\()@(?![a-zA-Z_+\\-*/=<>!?&|%^~#@0-9.\\->])",
      "name": "keyword.other.attribute.zscheme"
    },

    "head-keyword-other": {
      "match": "(?<=\\()(?:object|partial)(?![a-zA-Z_+\\-*/=<>!?&|%^~#@0-9.\\->])",
      "name": "keyword.other.zscheme"
    },

    "head-operator-pipe": {
      "match": "(?<=\\()\\|>(?![a-zA-Z_+\\-*/=<>!?&|%^~#@0-9.\\->])",
      "name": "keyword.operator.pipe.zscheme"
    },

    "head-operator": {
      "match": "(?<=\\()(?:<=|>=|!=|[+\\-*/%=<>])(?![a-zA-Z_+\\-*/=<>!?&|%^~#@0-9.\\->])",
      "name": "keyword.operator.zscheme"
    },

    "head-function-call": {
      "match": "(?<=\\()[a-zA-Z_+\\-*/=<>!?&|%^~#@][a-zA-Z_+\\-*/=<>!?&|%^~#@0-9.\\->]*",
      "name": "variable.function.zscheme"
    },

    "brackets": {
      "patterns": [
        {
          "match": "\\[",
          "name": "punctuation.section.brackets.begin.zscheme"
        },
        {
          "match": "\\]",
          "name": "punctuation.section.brackets.end.zscheme"
        }
      ]
    },

    "flag-keywords": {
      "match": "#:(?:open|mutable|init)(?![a-zA-Z_+\\-*/=<>!?&|%^~#@0-9.\\->])",
      "name": "keyword.other.flag.zscheme"
    },

    "head-type-name": {
      "comment": "Generic type constructors are applied, so they sit in head position — (List Int), (Hash String Long). Without this they would be claimed by head-function-call and the built-in type list would never fire for them.",
      "match": "(?<=\\()(?:Mutable-TreeList|TreeList|List|Vector|Hash|Option|Result|Fn|Task)(?![a-zA-Z_+\\-*/=<>!?&|%^~#@0-9.\\->])",
      "name": "storage.type.zscheme"
    },

    "super-call": {
      "comment": "(super/MethodName arg ...) — also legal as a bare atom, so this is included in both head and value position.",
      "match": "(?<![a-zA-Z_+\\-*/=<>!?&|%^~#@0-9.\\->])(super/)([a-zA-Z_+\\-*/=<>!?&|%^~#@0-9.\\->]*)",
      "captures": {
        "1": { "name": "keyword.control.super.zscheme" },
        "2": { "name": "variable.function.zscheme" }
      }
    },

    "clr-qualifiers": {
      "comment": "import-clr member qualifiers. Longest alternatives first: ':instance-property' would otherwise shadow ':instance-property-set'.",
      "match": ":(?:instance-property-init|instance-property-set|instance-indexer-set|instance-property|instance-indexer|instance|where|from)(?![a-zA-Z_+\\-*/=<>!?&|%^~#@0-9.\\->])",
      "name": "keyword.other.clr-qualifier.zscheme"
    },

    "colon": {
      "match": ":",
      "name": "punctuation.separator.annotation.zscheme"
    },

    "wildcard": {
      "match": "_(?![a-zA-Z_+\\-*/=<>!?&|%^~#@0-9.\\->])",
      "name": "variable.language.wildcard.zscheme"
    },

    "ellipsis": {
      "match": "\\.\\.\\.(?![a-zA-Z_+\\-*/=<>!?&|%^~#@0-9.\\->])",
      "name": "keyword.operator.ellipsis.zscheme"
    },

    "value-constructors": {
      "match": "(?:Some|None|Ok|Err|Error)(?![a-zA-Z_+\\-*/=<>!?&|%^~#@0-9.\\->])",
      "name": "constant.language.zscheme"
    },

    "type-names": {
      "patterns": [
        {
          "comment": "PrimitiveTypeNames.cs plus the stdlib generics. There is no 'Map' — packages/stdlib/src/map.zs is hash.zs and the type is Hash.",
          "match": "(?:Int|Long|Float|Double|Byte|Char|Bool|String|Unit|Symbol|List|TreeList|Mutable-TreeList|Vector|Hash|Option|Result|Fn|Task)(?![a-zA-Z_+\\-*/=<>!?&|%^~#@0-9.\\->])",
          "name": "storage.type.zscheme"
        },
        {
          "comment": "User-defined types. Scoped apart from the built-ins so the list above is load-bearing, matching how the Zed queries separate @type.builtin from @type.",
          "match": "[A-Z][a-zA-Z_+\\-*/=<>!?&|%^~#@0-9.\\->]*",
          "name": "entity.name.type.zscheme"
        }
      ]
    },

    "type-variables": {
      "match": "\\^[a-z][a-zA-Z_+\\-*/=<>!?&|%^~#@0-9.\\->]*",
      "name": "variable.parameter.type.zscheme"
    },

    "constraint-keywords": {
      "match": "(?:notnull|struct|unmanaged|default)(?![a-zA-Z_+\\-*/=<>!?&|%^~#@0-9.\\->])",
      "name": "keyword.other.constraint.zscheme"
    },

    "identifiers": {
      "match": "[a-zA-Z_+\\-*/=<>!?&|%^~#@][a-zA-Z_+\\-*/=<>!?&|%^~#@0-9.\\->]*",
      "name": "variable.other.zscheme"
    }
  }
}
