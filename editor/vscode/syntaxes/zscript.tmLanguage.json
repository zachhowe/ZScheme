{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "ZScript",
  "scopeName": "source.zscript",
  "fileTypes": ["zs", "zspkg"],
  "patterns": [
    { "include": "#expressions" }
  ],
  "repository": {
    "expressions": {
      "patterns": [
        { "include": "#line-comment" },
        { "include": "#string" },
        { "include": "#float" },
        { "include": "#integer" },
        { "include": "#boolean" },
        { "include": "#s-expression" },
        { "include": "#brackets" },
        { "include": "#clr-qualifiers" },
        { "include": "#colon" },
        { "include": "#wildcard" },
        { "include": "#ellipsis" },
        { "include": "#value-constructors" },
        { "include": "#type-names" },
        { "include": "#type-variables" },
        { "include": "#constraint-keywords" },
        { "include": "#identifiers" }
      ]
    },

    "line-comment": {
      "match": ";.*$",
      "name": "comment.line.semicolon.zscript"
    },

    "string": {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double.zscript",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.zscript" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.zscript" }
      },
      "patterns": [
        {
          "match": "\\\\[ntr\\\\\"']",
          "name": "constant.character.escape.zscript"
        }
      ]
    },

    "float": {
      "patterns": [
        {
          "match": "-?[0-9]+\\.[0-9]+[fF]?(?![a-zA-Z_+\\-*/=<>!?&|%^~#@0-9.\\->])",
          "name": "constant.numeric.float.zscript"
        },
        {
          "match": "-?[0-9]+[fF](?![a-zA-Z_+\\-*/=<>!?&|%^~#@0-9.\\->])",
          "name": "constant.numeric.float.zscript"
        },
        {
          "match": "\\.[0-9]+(?![a-zA-Z_+\\-*/=<>!?&|%^~#@0-9.\\->])",
          "name": "constant.numeric.float.zscript"
        }
      ]
    },

    "integer": {
      "match": "-?[0-9]+(?![.[0-9fF]])(?![a-zA-Z_+\\-*/=<>!?&|%^~#@0-9.\\->])",
      "name": "constant.numeric.integer.zscript"
    },

    "boolean": {
      "patterns": [
        {
          "match": "\\b(true|false)\\b",
          "name": "constant.language.boolean.zscript"
        },
        {
          "match": "(?:#t|#f)(?![a-zA-Z_+\\-*/=<>!?&|%^~#@0-9.\\->])",
          "name": "constant.language.boolean.zscript"
        }
      ]
    },

    "s-expression": {
      "begin": "\\(",
      "end": "\\)",
      "beginCaptures": {
        "0": { "name": "punctuation.section.parens.begin.zscript" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.section.parens.end.zscript" }
      },
      "patterns": [
        { "include": "#head-keyword-control" },
        { "include": "#head-keyword-module" },
        { "include": "#head-attribute" },
        { "include": "#head-keyword-manifest" },
        { "include": "#head-keyword-other" },
        { "include": "#head-operator-pipe" },
        { "include": "#head-operator" },
        { "include": "#head-function-call" },
        { "include": "#expressions" }
      ]
    },

    "head-keyword-control": {
      "match": "(?<=\\()(?:define-syntax|define-async|define|let\\*|let|if|fn|match|record|union|try|catch|\\?|begin|new|raise|await|class|interface|syntax-rules)(?![a-zA-Z_+\\-*/=<>!?&|%^~#@0-9.\\->])",
      "name": "keyword.control.zscript"
    },

    "head-keyword-module": {
      "match": "(?<=\\()(?:namespace|module|import|export|import-clr)(?![a-zA-Z_+\\-*/=<>!?&|%^~#@0-9.\\->])",
      "name": "keyword.control.module.zscript"
    },

    "head-attribute": {
      "match": "(?<=\\()@(?![a-zA-Z_+\\-*/=<>!?&|%^~#@0-9.\\->])",
      "name": "keyword.other.attribute.zscript"
    },

    "head-keyword-manifest": {
      "match": "(?<=\\()(?:package|dependencies|nuget|build|output|backend|stdlib|ref|name|version|entry)(?![a-zA-Z_+\\-*/=<>!?&|%^~#@0-9.\\->])",
      "name": "keyword.other.manifest.zscript"
    },

    "head-keyword-other": {
      "match": "(?<=\\()(?:object|partial|list|vector|map-of)(?![a-zA-Z_+\\-*/=<>!?&|%^~#@0-9.\\->])",
      "name": "keyword.other.zscript"
    },

    "head-operator-pipe": {
      "match": "(?<=\\()\\|>(?![a-zA-Z_+\\-*/=<>!?&|%^~#@0-9.\\->])",
      "name": "keyword.operator.pipe.zscript"
    },

    "head-operator": {
      "match": "(?<=\\()(?:<=|>=|!=|[+\\-*/%=<>])(?![a-zA-Z_+\\-*/=<>!?&|%^~#@0-9.\\->])",
      "name": "keyword.operator.zscript"
    },

    "head-function-call": {
      "match": "(?<=\\()[a-zA-Z_+\\-*/=<>!?&|%^~#@][a-zA-Z_+\\-*/=<>!?&|%^~#@0-9.\\->]*",
      "name": "variable.function.zscript"
    },

    "brackets": {
      "patterns": [
        {
          "match": "\\[",
          "name": "punctuation.section.brackets.begin.zscript"
        },
        {
          "match": "\\]",
          "name": "punctuation.section.brackets.end.zscript"
        }
      ]
    },

    "clr-qualifiers": {
      "match": ":(?:instance-property|instance-indexer|instance|where)(?![a-zA-Z_+\\-*/=<>!?&|%^~#@0-9.\\->])",
      "name": "keyword.other.clr-qualifier.zscript"
    },

    "colon": {
      "match": ":",
      "name": "punctuation.separator.annotation.zscript"
    },

    "wildcard": {
      "match": "_(?![a-zA-Z_+\\-*/=<>!?&|%^~#@0-9.\\->])",
      "name": "variable.language.wildcard.zscript"
    },

    "ellipsis": {
      "match": "\\.\\.\\.(?![a-zA-Z_+\\-*/=<>!?&|%^~#@0-9.\\->])",
      "name": "keyword.operator.ellipsis.zscript"
    },

    "value-constructors": {
      "match": "(?:Some|None|Ok|Err|Error)(?![a-zA-Z_+\\-*/=<>!?&|%^~#@0-9.\\->])",
      "name": "constant.language.zscript"
    },

    "type-names": {
      "patterns": [
        {
          "match": "(?:Int|Float|Bool|String|Unit|List|Vector|Map|Option|Result|Fn|Task)(?![a-zA-Z_+\\-*/=<>!?&|%^~#@0-9.\\->])",
          "name": "storage.type.zscript"
        },
        {
          "match": "[A-Z][a-zA-Z_+\\-*/=<>!?&|%^~#@0-9.\\->]*",
          "name": "storage.type.zscript"
        }
      ]
    },

    "type-variables": {
      "match": "\\^[a-z][a-zA-Z_+\\-*/=<>!?&|%^~#@0-9.\\->]*",
      "name": "variable.parameter.type.zscript"
    },

    "constraint-keywords": {
      "match": "(?:notnull|struct|unmanaged|default)(?![a-zA-Z_+\\-*/=<>!?&|%^~#@0-9.\\->])",
      "name": "keyword.other.constraint.zscript"
    },

    "identifiers": {
      "match": "[a-zA-Z_+\\-*/=<>!?&|%^~#@][a-zA-Z_+\\-*/=<>!?&|%^~#@0-9.\\->]*",
      "name": "variable.other.zscript"
    }
  }
}
